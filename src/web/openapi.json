{
 "openapi": "3.1.0",
 "info": {
  "title": "Picacho Server admin API",
  "version": "1",
  "description": "Manage domains, accounts, aliases, the delivery queue and live settings. Authenticate with `Authorization: Bearer pmk_…` using a token that has the `admin` scope (create one in the console under API & tokens)."
 },
 "servers": [
  {
   "url": "/api/v1"
  }
 ],
 "security": [
  {
   "bearer": []
  }
 ],
 "components": {
  "securitySchemes": {
   "bearer": {
    "type": "http",
    "scheme": "bearer"
   }
  },
  "responses": {
   "Error": {
    "description": "Error",
    "content": {
     "application/json": {
      "schema": {
       "type": "object",
       "properties": {
        "error": {
         "type": "string"
        }
       }
      }
     }
    }
   }
  },
  "schemas": {
   "Account": {
    "type": "object",
    "properties": {
     "id": {
      "type": "integer"
     },
     "email": {
      "type": "string"
     },
     "display_name": {
      "type": "string"
     },
     "role": {
      "type": "string",
      "enum": [
       "user",
       "admin"
      ]
     },
     "quota_bytes": {
      "type": "integer"
     },
     "used_bytes": {
      "type": "integer"
     },
     "active": {
      "type": "boolean"
     },
     "can_send_external": {
      "type": "boolean"
     },
     "forward_to": {
      "type": "string"
     },
     "keep_copy": {
      "type": "boolean"
     },
     "created_at": {
      "type": "integer"
     },
     "last_login": {
      "type": [
       "integer",
       "null"
      ]
     }
    }
   },
   "NewAccount": {
    "type": "object",
    "required": [
     "email"
    ],
    "properties": {
     "email": {
      "type": "string"
     },
     "password": {
      "type": "string",
      "description": "Required unless oidc_subject is given."
     },
     "display_name": {
      "type": "string"
     },
     "role": {
      "type": "string",
      "enum": [
       "user",
       "admin"
      ]
     },
     "quota_mb": {
      "type": "integer"
     },
     "oidc_subject": {
      "type": "string",
      "description": "The identity provider's `sub` for this person. Links the mailbox, so single sign-on and the provider's access tokens resolve to it. 409 if the identity already has a mailbox."
     },
     "encryption_key": {
      "type": "string",
      "description": "An OpenPGP public key (armored). Mail delivered to the account is stored encrypted to it (PGP/MIME), so only the key's owner can read it. 400 if it isn't a usable encryption key."
     }
    }
   },
   "AccountPatch": {
    "type": "object",
    "properties": {
     "display_name": {
      "type": "string"
     },
     "role": {
      "type": "string"
     },
     "quota_mb": {
      "type": "integer"
     },
     "active": {
      "type": "boolean"
     },
     "can_send_external": {
      "type": "boolean"
     },
     "forward_to": {
      "type": "string"
     },
     "keep_copy": {
      "type": "boolean"
     },
     "oidc_subject": {
      "type": "string",
      "description": "Link the mailbox to this identity provider subject; an empty string unlinks it."
     },
     "encryption_key": {
      "type": "string",
      "description": "Replace the encryption-at-rest key, or \"\" to stop encrypting new mail (mail already encrypted stays encrypted)."
     }
    }
   },
   "Domain": {
    "type": "object",
    "properties": {
     "id": {
      "type": "integer"
     },
     "name": {
      "type": "string"
     },
     "mode": {
      "type": "string",
      "enum": [
       "local",
       "relay",
       "webhook"
      ]
     },
     "transport": {
      "type": "string"
     },
     "catch_all": {
      "type": "string"
     },
     "dkim_selector": {
      "type": "string"
     },
     "dkim_public": {
      "type": "string"
     },
     "active": {
      "type": "boolean"
     }
    }
   },
   "NewDomain": {
    "type": "object",
    "required": [
     "name"
    ],
    "properties": {
     "name": {
      "type": "string"
     },
     "mode": {
      "type": "string"
     },
     "transport": {
      "type": "string"
     },
     "dkim": {
      "type": "boolean"
     }
    }
   },
   "DomainPatch": {
    "type": "object",
    "properties": {
     "mode": {
      "type": "string"
     },
     "transport": {
      "type": "string"
     },
     "catch_all": {
      "type": "string"
     },
     "active": {
      "type": "boolean"
     }
    }
   },
   "Alias": {
    "type": "object",
    "properties": {
     "id": {
      "type": "integer"
     },
     "source": {
      "type": "string"
     },
     "destination": {
      "type": "string"
     },
     "active": {
      "type": "boolean"
     }
    }
   },
   "QueueItem": {
    "type": "object",
    "properties": {
     "id": {
      "type": "integer"
     },
     "sender": {
      "type": "string"
     },
     "recipients": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "status": {
      "type": "string"
     },
     "attempts": {
      "type": "integer"
     },
     "last_error": {
      "type": "string"
     },
     "next_attempt": {
      "type": "integer"
     }
    }
   },
   "EncryptionKey": {
    "type": "object",
    "properties": {
     "encrypted": {
      "type": "boolean"
     },
     "fingerprint": {
      "type": [
       "string",
       "null"
      ],
      "description": "Uppercase hex OpenPGP fingerprint."
     },
     "updated_at": {
      "type": [
       "integer",
       "null"
      ]
     }
    }
   }
  }
 },
